    <style type="text/css" data-type="vc_custom-css">.ticker-wrapper-h{
    display: flex;  
    position: relative;
    overflow: hidden;
    border: 1px solid #ff0000 !important;
    background-color: #ff0000 !important;
    box-shadow: 0 6px 6px rgb(0 0 0 / 32%); 
    padding:  10px;
}

.news-ticker-h{
    display: flex;
    margin:0;
    padding: 0;
    padding-left: 90%;
    
    animation-iteration-count: infinite;
    animation-timing-function: linear;
    animation-name: tic-h;
    animation-duration: 20s;
    
}
.news-ticker-h:hover { 
    color: #00a0e3;
}

.news-ticker-h li{
    display: flex;
    width: 100%;
    align-items: center;
    white-space: nowrap;
    padding-left: 20px;
}

.news-ticker-h li a{
    color: #fff;
    font-weight: bold;
    font-size: 14px;
}
.news-ticker-h li a:hover{
    color: #A93226;
    font-weight: bold;
}

@keyframes tic-h {
    0% {
        -webkit-transform: translate3d(0, 0, 0);
        transform: translate3d(0, 0, 0);
        visibility: visible;
    }
    100% {
        -webkit-transform: translate3d(-100%, 0, 0);
        transform: translate3d(-100%, 0, 0);
    }

    "repaired_code": "import os\nimport json\nimport requests\nfrom bs4 import BeautifulSoup\nfrom datetime import datetime\nfrom urllib.parse import urljoin\n\ndef fetch_news():\n    url = \"https://www.bundesbank.de/en/tasks/topics\"\n    response = requests.get(url)\n    response.raise_for_status()\n    \n    soup = BeautifulSoup(response.text, 'html.parser')\n    \n    # 定位到新闻列表区域\n    news_section = soup.find('div', class_='teaser-list')  # 修正选择器以匹配实际页面结构\n    articles = []\n    \n    if news_section:\n        news_items = news_section.find_all('div', class_='teaser', limit=5)  # 修正选择器以匹配实际页面结构\n        \n        for item in news_items:\n            title_tag = item.find('h3')\n            link_tag = item.find('a', href=True)\n            \n            # 确保提取到的字段不为空\n            if title_tag and link_tag:\n                title = title_tag.get_text(strip=True)\n                source_url = urljoin(url, link_tag['href'])\n                \n                articles.append({\n                    \"title\": title,  # 修正字段名为 'title' 以符合 JSON 输出要求\n                    \"sourceUrl\": source_url\n                })\n    \n    return articles\n\ndef save_results(articles, output_path):\n    result = {\n        \"total\": len(articles),\n        \"crawlTime\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n        \"articles\": articles\n    }\n    with open(output_path, 'w', encoding='utf-8') as f:\n        json.dump(result, f, ensure_ascii=False, indent=2)\n    print(f\"已保存 {len(articles)} 条新闻到 {output_path}\")\n\ndef main():\n    OUTPUT_DIR = \"d:/llm_mcp_genpy/pygen/output\"\n    os.makedirs(OUTPUT_DIR, exist_ok=True)\n    \n    articles = fetch_news()\n    \n    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n    json_path = os.path.join(OUTPUT_DIR, f\"bundesbank_news_{timestamp}.json\")\n    \n    save_results(articles, json_path)\n\nif __name__ == \"__main__\":\n    main()",

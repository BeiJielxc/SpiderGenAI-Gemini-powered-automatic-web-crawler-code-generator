  "repaired_code": "import os\nimport json\nimport requests\nfrom bs4 import BeautifulSoup\nfrom datetime import datetime\nfrom urllib.parse import urljoin\n\ndef clean_html_content(html_content, base_url):\n    \"\"\"将 HTML 中的相对路径转换为绝对路径\"\"\"\n    if not html_content:\n        return \"\"\n    try:\n        soup = BeautifulSoup(html_content, 'html.parser')\n        \n        # 修复图片链接\n        for img in soup.find_all('img'):\n            if img.get('src'):\n                img['src'] = urljoin(base_url, img['src'])\n                \n        # 修复超链接\n        for a in soup.find_all('a'):\n            if a.get('href'):\n                a['href'] = urljoin(base_url, a['href'])\n                \n        return str(soup)\n    except Exception as e:\n        print(f\"内容清洗出错: {e}\")\n        return html_content\n\ndef crawl_news():\n    url = \"https://www.news.bundesbank.de/news-de\"\n    response = requests.get(url)\n    response.raise_for_status()\n    \n    soup = BeautifulSoup(response.text, 'html.parser')\n    \n    # 识别用户标注的红框区域\n    news_section = soup.find('div', {'id': 'stage-widget'})\n    articles = []\n    \n    if news_section:\n        # 修复选择器以确保获取正确的新闻项\n        news_items = news_section.find_all('article', limit=5)  # 假设新闻项是 <article> 标签\n        for item in news_items:\n            title_tag = item.find('h2')  # 假设标题在 <h2> 标签中\n            link_tag = item.find('a')  # 假设链接在 <a> 标签中\n            \n            if title_tag and link_tag:\n                title = title_tag.get_text(strip=True)\n                source_url = link_tag['href']\n                source_url = urljoin(url, source_url)\n                content = str(item)\n                content = clean_html_content(content, url)\n                \n                articles.append({\n                    \"title\": title,\n                    \"sourceUrl\": source_url,\n                    \"content\": content\n                })\n    \n    return articles\n\ndef save_results(articles: list, output_path: str):\n    # 保存爬取结果为JSON\n    result = {\n        \"total\": len(articles),\n        \"crawlTime\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n        \"articles\": articles\n    }\n    with open(output_path, 'w', encoding='utf-8') as f:\n        json.dump(result, f, ensure_ascii=False, indent=2)\n    print(f\"已保存 {len(articles)} 条新闻到 {output_path}\")\n\ndef main():\n    OUTPUT_DIR = \"d:\\\\llm_mcp_genpy\\\\pygen\\\\output\"\n    os.makedirs(OUTPUT_DIR, exist_ok=True)\n    \n    # 爬取新闻\n    articles = crawl_news()\n    \n    # 保存结果\n    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n    json_path = os.path.join(OUTPUT_DIR, f\"bundesbank_news_{timestamp}.json\")\n    \n    save_results(articles, json_path)\n\nif __name__ == \"__main__\":\n    main()",
